---
import { Image } from "astro:assets";
import Hotspot from "./Hotspot.astro";
import Panel from "./Panel.astro";
import zonas from "../data/zonas.json";
import productos from "../data/productos.json";
import escena from "../assets/gymbox/final_gym_box.jpeg";

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ GymBox — hero interactivo. MISMA técnica en móvil y desktop.              │
// │ Las 3 rutas de la interacción (implementadas en src/scripts/gymbox.ts):  │
// │                                                                          │
// │   tap / Enter en zona ─┬─ reduced-motion? SÍ → corte: gsap.set al estado │
// │      (JS activo)       │     final, fade corto del panel                 │
// │                        └─ NO → tween transform de .camara (0.5-0.7s) →   │
// │                               scrim fade → panel fade-in                 │
// │   sin JS ───────────────  <a href="#grips"> navega a la sección keynote  │
// │                           (hotspots inactivos: <button> sin acción)      │
// └──────────────────────────────────────────────────────────────────────────┘

const gripsZona = zonas.find((z) => z.id === "grips")!;
// Membresía zona↔producto vive SOLO en productos[].zona (igual que
// ProductGrid.astro) — zonas.json ya no tiene su propio array de slugs.
// Antes había dos fuentes para el mismo dato: un producto podía pasar la
// validación de build y aun así no aparecer acá si nadie actualizaba
// zonas.json a mano. El orden lo da el orden de filas de la fuente de datos.
const gripsProductos = productos.filter((p) => p.zona === gripsZona.id);
---

<section class="gymbox" id="top" tabindex="-1" aria-label="El box GuaguaFit">
  <div class="camara" data-camara>
    <!-- Escena del box (IA, src/assets/gymbox/final_gym_box.jpeg — imagen
         final aprobada por José). Ajustar aquí (no en zonas.json) si se
         cambia la imagen y los hotspots se desalinean. -->
    <div class="escena">
      <Image
        src={escena}
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        widths={[640, 960, 1280, 1600, 1920, 2560]}
        sizes="100vw"
        class="escena__img"
      />

      {zonas.map((z) => <Hotspot zona={z} />)}
    </div>
  </div>

  <h1 class="sr-only">GuaguaFit — entrá al box</h1>
  <p class="gymbox__lede">Tocá una zona para ver qué hay.</p>

  <div class="gymbox__cue" aria-hidden="true">
    <span>Desplazá</span>
    <span class="gymbox__cue-arrow">↓</span>
  </div>

  <!-- Scrim del zoom (fade-in por opacity). -->
  <div class="scrim" data-scrim aria-hidden="true"></div>

  <!-- Panels: uno real para grips, uno compartido "Pronto". -->
  <Panel
    id={gripsZona.id}
    nombre={gripsZona.nombre}
    activa={true}
    productos={gripsProductos}
  />
  <Panel id="__pronto" nombre="Pronto" activa={false} />
</section>

<style>
  .gymbox {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: var(--negro);
  }

  .camara {
    position: absolute;
    inset: 0;
    will-change: transform;
    transform-origin: 50% 50%;
  }

  .escena {
    position: absolute;
    inset: 0;
    min-height: 100svh;
    background: var(--negro);
  }

  .escena::after {
    /* Scrim leve para que la copy/hotspots del hero mantengan contraste
       sobre las zonas más claras de la ilustración. */
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(10, 10, 9, 0.55) 0%,
      rgba(10, 10, 9, 0.15) 35%,
      rgba(10, 10, 9, 0.1) 70%,
      rgba(10, 10, 9, 0.4) 100%
    );
    pointer-events: none;
  }

  .escena__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* La escena es muy panorámica: en mobile `cover` solo deja ~26% del
     ancho visible, centrado en el punto de recorte. "Grips" (la única
     zona activa) está cerca del centro de la imagen (barra de dominadas
     del rig), así que el centrado por default ya la deja en cuadro —
     a diferencia de la composición anterior, no hace falta desplazar
     `object-position` en mobile. */

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .gymbox__lede {
    position: absolute;
    top: 6.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    margin: 0;
    text-align: center;
    font-size: clamp(1rem, 2.4vw, 1.35rem);
    color: var(--crema);
    text-shadow: 0 2px 16px rgba(10, 10, 9, 0.7);
    pointer-events: none;
  }

  .gymbox__cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--crema) 70%, transparent);
  }

  .gymbox__cue-arrow {
    animation: cue-bob 1.8s ease-in-out infinite;
  }

  @keyframes cue-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  .scrim {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: var(--negro-scrim);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .gymbox__cue-arrow {
      animation: none;
    }
  }
</style>

<script>
  import { initGymBox } from "../scripts/gymbox";
  initGymBox();
</script>
